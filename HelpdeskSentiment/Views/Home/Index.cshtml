@{
    ViewData["Title"] = "Helpdesk Intelligence";
}

<!-- Hero Section -->
<div class="card border-0 shadow-sm mb-4 text-white overflow-hidden" style="background: linear-gradient(135deg, #0284c7 0%, #0369a1 50%, #0f172a 100%); border-radius: 1rem;">
    <div class="card-body p-4 p-md-5">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-white bg-opacity-25 text-white mb-3 px-3 py-2 text-uppercase" style="letter-spacing: 0.05em; font-size: 0.75rem;">
                    <i class="bi bi-stars me-1"></i> INT402 Modern Web Programming &bull; MVC Frontend
                </span>
                <h1 class="display-6 fw-bold mb-2">Automated Helpdesk Call Sentiment & Escalation</h1>
                <p class="lead text-white-50 mb-4" style="max-width: 650px;">
                    Capture call transcripts, automatically calculate caller sentiment score (-1 to +1) using a C# Lexicon engine, and proactively flag upset callers before customer churn.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="Calls" asp-action="Create" class="btn btn-light text-primary fw-semibold px-4 py-2 shadow-sm">
                        <i class="bi bi-telephone-plus me-1"></i> Log New Call
                    </a>
                    <a asp-controller="Calls" asp-action="Index" class="btn btn-outline-light px-4 py-2">
                        <i class="bi bi-list-task me-1"></i> View All Calls
                    </a>
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-light px-4 py-2">
                        <i class="bi bi-speedometer2 me-1"></i> Supervisor Dashboard
                    </a>
                    <a asp-controller="Analyze" asp-action="Index" class="btn btn-outline-light px-4 py-2">
                        <i class="bi bi-cpu me-1"></i> Text Playground
                    </a>
                </div>
            </div>
            <div class="col-lg-4 text-center mt-4 mt-lg-0 d-none d-lg-block">
                <div class="bg-white bg-opacity-10 rounded-4 p-4 border border-white border-opacity-15 backdrop-blur">
                    <div class="fs-1 mb-2">📈</div>
                    <div class="h5 fw-bold text-white mb-1">Lexicon Engine Active</div>
                    <div class="small text-white-50">Word list tokenisation, negation detection ("not happy"), & intensifiers ("very angry")</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Architecture & Features Row -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm p-3">
            <div class="card-body">
                <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-3 p-3 mb-3 fs-4">
                    <i class="bi bi-headset"></i>
                </div>
                <h3 class="h5 fw-bold mb-2">1. Call Logging & Validation</h3>
                <p class="text-muted small mb-3">
                    Agents input caller details, category, duration, and full conversation transcripts. Protected with both jQuery client-side validation and ASP.NET Core server-side <code>ModelState</code>.
                </p>
                <a asp-controller="Calls" asp-action="Create" class="btn btn-sm btn-outline-primary">
                    Try Form Validation &rarr;
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm p-3">
            <div class="card-body">
                <div class="d-inline-flex align-items-center justify-content-center bg-danger bg-opacity-10 text-danger rounded-3 p-3 mb-3 fs-4">
                    <i class="bi bi-shield-exclamation"></i>
                </div>
                <h3 class="h5 fw-bold mb-2">2. Sentiment & Escalations</h3>
                <p class="text-muted small mb-3">
                    Scored on a normalized spectrum from -1.0 to +1.0. Transcripts containing anger signals or legal keywords automatically trigger an <strong>Escalation Flag</strong> for immediate supervisor callback.
                </p>
                <a asp-controller="Analyze" asp-action="Index" class="btn btn-sm btn-outline-danger">
                    Test Sentiment Engine &rarr;
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm p-3">
            <div class="card-body">
                <div class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success rounded-3 p-3 mb-3 fs-4">
                    <i class="bi bi-pie-chart"></i>
                </div>
                <h3 class="h5 fw-bold mb-2">3. Supervisor Intelligence</h3>
                <p class="text-muted small mb-3">
                    Supervisors view interactive Chart.js doughnut and bar breakdowns, average agent sentiment scores, and recently viewed calls stored in <strong>HTTP Session state</strong>.
                </p>
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-sm btn-outline-success">
                    Open Supervisor View &rarr;
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Tech Stack Ribbon -->
<div class="card border-0 shadow-sm bg-white p-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span class="small fw-bold text-muted text-uppercase">Tech Stack & Architecture:</span>
        <div class="d-flex flex-wrap gap-2">
            <span class="badge bg-light text-dark border"><i class="bi bi-code-slash text-primary me-1"></i> C# .NET 10</span>
            <span class="badge bg-light text-dark border"><i class="bi bi-layout-wtf text-info me-1"></i> ASP.NET Core MVC</span>
            <span class="badge bg-light text-dark border"><i class="bi bi-database text-warning me-1"></i> EF Core Code First (LocalDB)</span>
            <span class="badge bg-light text-dark border"><i class="bi bi-graph-up text-success me-1"></i> Chart.js</span>
            <span class="badge bg-light text-dark border"><i class="bi bi-lock text-danger me-1"></i> Cookie Authentication</span>
            <span class="badge bg-light text-dark border"><i class="bi bi-hdd-network text-secondary me-1"></i> REST Web API</span>
        </div>
    </div>
</div>
