<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Helpdesk Sentiment</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HelpdeskSentiment.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-xs mb-3">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand d-flex align-items-center gap-2 text-primary text-decoration-none" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="fs-4">🎧</span>
                    <div>
                        <div class="fw-bold lh-1 text-dark">Helpdesk <span class="text-primary">Sentiment</span></div>
                        <div class="text-muted" style="font-size: 0.68rem; letter-spacing: 0.05em; font-weight: 600;">INT402 INTELLIGENCE PORTAL</div>
                    </div>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house me-1"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Calls" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-area="" asp-controller="Calls" asp-action="Index">
                                <i class="bi bi-telephone-inbound me-1"></i> Calls
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Calls" && ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")" asp-area="" asp-controller="Calls" asp-action="Create">
                                <i class="bi bi-plus-circle me-1"></i> Log Call
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-area="" asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-speedometer2 me-1"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Analyze" ? "active" : "")" asp-area="" asp-controller="Analyze" asp-action="Index">
                                <i class="bi bi-cpu me-1"></i> Analyse Text
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid px-lg-4">
        <main role="main" class="pb-4">
            @if (TempData["Message"] is string message)
            {
                <div class="alert alert-@(TempData["MessageType"] ?? "success") alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-3" role="alert">
                    <i class="bi @(TempData["MessageType"]?.ToString() == "warning" ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") fs-5"></i>
                    <div>@message</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted bg-white border-top">
        <div class="container-fluid px-lg-4 d-flex flex-column flex-md-row justify-content-between align-items-center py-2 gap-1">
            <span class="small">&copy; 2026 <strong>Helpdesk Sentiment Analysis</strong> — INT402 Team Project</span>
            <span class="small text-secondary">
                Frontend: <strong>Priyanshu Tanwar</strong> (feature/mvc-ui) &bull; ASP.NET Core MVC (.NET 10) &bull; LocalDB
            </span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
