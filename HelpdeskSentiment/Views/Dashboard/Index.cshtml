@model List<CallRecord>
@{
    var byCategory = (Dictionary<string, int>)ViewBag.ByCategory;
    var byAgent = (Dictionary<string, double>)ViewBag.ByAgent;

    int total = (int)(ViewData["TotalCalls"] ?? 0);
    int pos = (int)(ViewBag.Positive ?? 0);
    int neu = (int)(ViewBag.Neutral ?? 0);
    int neg = (int)(ViewBag.Negative ?? 0);
    int esc = (int)(ViewBag.Escalated ?? 0);
    double avgScore = (double)(ViewData["AverageScore"] ?? 0.0);

    double posPct = total > 0 ? Math.Round((double)pos / total * 100, 1) : 0;
    double negPct = total > 0 ? Math.Round((double)neg / total * 100, 1) : 0;
    double escPct = total > 0 ? Math.Round((double)esc / total * 100, 1) : 0;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-2">
    <div>
        <h1 class="h3 fw-bold mb-1 d-flex align-items-center gap-2">
            <span>Supervisor Analytics Dashboard</span>
            <span class="badge bg-danger-subtle text-danger border border-danger-subtle fs-6 rounded-pill">
                <i class="bi bi-shield-lock-fill me-1"></i> Admin Role
            </span>
        </h1>
        <p class="text-muted mb-0 small">Aggregated call volume, sentiment distribution metrics, and agent performance.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Calls" asp-action="Index" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-list-task me-1"></i> View All Calls
        </a>
    </div>
</div>

<!-- KPI Metric Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg">
        <div class="card border-0 shadow-sm text-center h-100 p-2">
            <div class="card-body">
                <div class="text-muted small fw-semibold text-uppercase">Total Calls</div>
                <div class="display-6 fw-bold text-dark my-1">@total</div>
                <div class="small text-muted"><i class="bi bi-telephone me-1"></i> All categories</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg">
        <div class="card border-0 shadow-sm text-center h-100 p-2 border-top border-4 border-success">
            <div class="card-body">
                <div class="text-muted small fw-semibold text-uppercase">Positive Calls</div>
                <div class="display-6 fw-bold text-success my-1">@pos</div>
                <div class="small text-success fw-semibold">@posPct% of total</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg">
        <div class="card border-0 shadow-sm text-center h-100 p-2 border-top border-4 border-secondary">
            <div class="card-body">
                <div class="text-muted small fw-semibold text-uppercase">Neutral Calls</div>
                <div class="display-6 fw-bold text-secondary my-1">@neu</div>
                <div class="small text-muted">Standard requests</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg">
        <div class="card border-0 shadow-sm text-center h-100 p-2 border-top border-4 border-danger">
            <div class="card-body">
                <div class="text-muted small fw-semibold text-uppercase">Negative Calls</div>
                <div class="display-6 fw-bold text-danger my-1">@neg</div>
                <div class="small text-danger fw-semibold">@negPct% of total</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg">
        <div class="card border-0 shadow-sm text-center h-100 p-2 border-top border-4 border-primary">
            <div class="card-body">
                <div class="text-muted small fw-semibold text-uppercase">Avg Sentiment Score</div>
                <div class="display-6 fw-bold @(avgScore < 0 ? "text-danger" : "text-primary") my-1">
                    @avgScore.ToString("+0.00;-0.00;0.00")
                </div>
                <div class="small text-muted"><span class="badge bg-danger">@esc Escalated (@escPct%)</span></div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row g-4 mb-4">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span class="fw-bold"><i class="bi bi-pie-chart text-primary me-1"></i> Sentiment Breakdown</span>
                <span class="badge bg-light text-muted border">Chart.js</span>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center p-4">
                <div style="position: relative; width: 100%; max-height: 260px;">
                    <canvas id="sentimentChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span class="fw-bold"><i class="bi bi-bar-chart-line text-primary me-1"></i> Calls by Category</span>
                <span class="badge bg-light text-muted border">Distribution</span>
            </div>
            <div class="card-body p-4">
                <div style="position: relative; width: 100%; max-height: 260px;">
                    <canvas id="categoryChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Agent Mood & Escalation Queue Row -->
<div class="row g-4">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white">
                <span class="fw-bold"><i class="bi bi-people text-primary me-1"></i> Average Caller Mood per Agent</span>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Agent</th>
                            <th class="text-end pe-3">Average Score</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (byAgent.Count == 0)
                        {
                            <tr><td colspan="2" class="text-center text-muted py-3">No agent calls logged yet.</td></tr>
                        }
                        @foreach (var pair in byAgent.OrderBy(p => p.Value))
                        {
                            <tr>
                                <td class="ps-3 fw-semibold">
                                    <i class="bi bi-person-circle me-1 text-secondary"></i> @pair.Key
                                </td>
                                <td class="text-end pe-3 font-monospace fw-bold @(pair.Value < 0 ? "text-danger" : "text-success")">
                                    @pair.Value.ToString("+0.00;-0.00;0.00")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span class="fw-bold text-danger">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> Requires Immediate Callback (@esc Escalated)
                </span>
                <a asp-controller="Calls" asp-action="Index" asp-route-sentiment="Negative" class="small text-decoration-none">
                    View all negative calls &rarr;
                </a>
            </div>
            <ul class="list-group list-group-flush">
                @if (Model.Count == 0)
                {
                    <li class="list-group-item text-muted text-center py-4">
                        <i class="bi bi-check2-circle fs-3 text-success d-block mb-1"></i>
                        No escalated calls currently queued! 🎉
                    </li>
                }
                @foreach (var call in Model)
                {
                    <li class="list-group-item p-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <a asp-controller="Calls" asp-action="Details" asp-route-id="@call.Id" class="fw-bold text-decoration-none text-dark">
                                @call.CallerName
                            </a>
                            <span class="badge bg-danger">Escalated</span>
                        </div>
                        <div class="text-muted small mb-1">
                            <span class="font-monospace">@call.PhoneNumber</span> &bull; 
                            <span class="badge bg-light text-dark border">@call.Category</span> &bull; 
                            <span>@call.CallTime.ToString("dd MMM, HH:mm")</span>
                        </div>
                        <div class="small text-secondary text-truncate font-monospace bg-light p-2 rounded">
                            "@call.Transcript"
                        </div>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <script>
        // Doughnut Chart for Sentiment Split
        new Chart(document.getElementById('sentimentChart'), {
            type: 'doughnut',
            data: {
                labels: ['Positive', 'Neutral', 'Negative'],
                datasets: [{
                    data: [@pos, @neu, @neg],
                    backgroundColor: ['#16a34a', '#94a3b8', '#dc2626'],
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 12, font: { family: 'Inter', weight: 500 } } }
                },
                cutout: '65%'
            }
        });

        // Bar Chart for Category Distribution
        new Chart(document.getElementById('categoryChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(byCategory.Keys)),
                datasets: [{
                    label: 'Call Volume',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(byCategory.Values)),
                    backgroundColor: '#0284c7',
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { precision: 0, font: { family: 'Inter' } },
                        grid: { color: '#f1f5f9' }
                    },
                    x: {
                        grid: { display: false },
                        ticks: { font: { family: 'Inter' } }
                    }
                }
            }
        });
    </script>
}
