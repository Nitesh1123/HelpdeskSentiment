@model LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="row justify-content-center py-4">
    <div class="col-md-6 col-lg-5 col-xl-4">
        <div class="text-center mb-4">
            <div class="display-6 text-primary mb-2"><i class="bi bi-shield-lock"></i></div>
            <h1 class="h3 fw-bold text-dark mb-1">Helpdesk Sign In</h1>
            <p class="text-muted small">Enter your credentials to access the calls dashboard.</p>
        </div>

        <div class="card border-0 shadow-sm p-4">
            <form asp-action="Login" method="post">
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm mb-3"></div>
                
                <div class="mb-3">
                    <label asp-for="Username" class="form-label">
                        <i class="bi bi-person me-1 text-primary"></i> Username
                    </label>
                    <input asp-for="Username" id="loginUsername" class="form-control" autocomplete="username" placeholder="e.g. admin" />
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>
                
                <div class="mb-3">
                    <label asp-for="Password" class="form-label">
                        <i class="bi bi-key me-1 text-primary"></i> Password
                    </label>
                    <input asp-for="Password" id="loginPassword" class="form-control" autocomplete="current-password" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                
                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm mt-2">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                </button>
            </form>

            <div class="border-top mt-4 pt-3 text-center">
                <span class="text-muted small d-block mb-2">Quick autofill demo accounts:</span>
                <div class="d-flex justify-content-center gap-2">
                    <button type="button" class="quick-chip" onclick="fillLogin('admin', 'Admin@123')">
                        👑 Admin (Supervisor)
                    </button>
                    <button type="button" class="quick-chip" onclick="fillLogin('agent', 'Agent@123')">
                        🎧 Helpdesk Agent
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillLogin(u, p) {
            document.getElementById('loginUsername').value = u;
            document.getElementById('loginPassword').value = p;
        }
    </script>
}
