@model RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="row justify-content-center py-4">
    <div class="col-md-8 col-lg-6 col-xl-5">
        <div class="text-center mb-4">
            <div class="display-6 text-primary mb-2"><i class="bi bi-person-plus-fill"></i></div>
            <h1 class="h3 fw-bold text-dark mb-1">Create an Account</h1>
            <p class="text-muted small">Register via multi-platform SSO or create an account with email.</p>
        </div>

        <div class="card border-0 shadow-sm p-4">
            <!-- Multi-Platform Sign Up via Clerk -->
            <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="text-dark small fw-semibold">Instant Social Sign Up</span>
                <span class="clerk-badge"><i class="bi bi-lightning-charge-fill me-1"></i>Clerk Auth</span>
            </div>

            <div class="d-grid gap-2 mb-2">
                <button type="button" class="btn-social" onclick="startClerkAuth('google')">
                    <i class="bi bi-google text-danger fs-5"></i>
                    <span>Sign up with Google</span>
                </button>
                <button type="button" class="btn-social" onclick="startClerkAuth('github')">
                    <i class="bi bi-github text-dark fs-5"></i>
                    <span>Sign up with GitHub</span>
                </button>
                <button type="button" class="btn-social" onclick="startClerkAuth('microsoft')">
                    <i class="bi bi-microsoft text-primary fs-5"></i>
                    <span>Sign up with Microsoft</span>
                </button>
                <button type="button" class="btn-social btn-social-clerk" onclick="startClerkAuth('clerk')">
                    <i class="bi bi-shield-lock-fill me-1"></i>
                    <span>All Platform Options (Universal Clerk Modal)</span>
                </button>
            </div>

            <div class="social-divider">
                <span>or register with email</span>
            </div>

            <form asp-action="Register" method="post">
                <input type="hidden" asp-for="ReturnUrl" id="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm mb-3"></div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label">
                        <i class="bi bi-person me-1 text-primary"></i> Full Name
                    </label>
                    <input asp-for="FullName" class="form-control" placeholder="e.g. Rahul Sharma" autocomplete="name" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Username" class="form-label">
                            <i class="bi bi-at me-1 text-primary"></i> Username
                        </label>
                        <input asp-for="Username" class="form-control" placeholder="e.g. rsharma" autocomplete="username" />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label">
                            <i class="bi bi-envelope me-1 text-primary"></i> Email Address
                        </label>
                        <input asp-for="Email" class="form-control" type="email" placeholder="name@helpdesk.local" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Role" class="form-label">
                        <i class="bi bi-shield-lock me-1 text-primary"></i> Account Role
                    </label>
                    <select asp-for="Role" class="form-select">
                        <option value="Agent">Support Agent (Log calls, live sentiment, call records)</option>
                        <option value="Admin">Helpdesk Supervisor (Analytics, reports, call management)</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger small"></span>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label">
                            <i class="bi bi-key me-1 text-primary"></i> Password
                        </label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" placeholder="Min. 6 chars" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label">
                            <i class="bi bi-check2-circle me-1 text-primary"></i> Confirm
                        </label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Re-type password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm mt-3">
                    <i class="bi bi-person-check me-1"></i> Register & Sign In
                </button>
            </form>

            <div class="border-top mt-4 pt-3 text-center">
                <span class="text-muted small">Already have an account? </span>
                <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-primary fw-semibold small text-decoration-none">
                    Sign in here <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        window.CLERK_PUBLISHABLE_KEY = '@(ViewBag.ClerkPublishableKey ?? "pk_test_Y2xlcmsuaGVscGRlc2suc2VudGltZW50LmRlbW8k")';
    </script>
    <script src="~/js/clerk-auth.js" asp-append-version="true"></script>
}
