@model CallRecord
@{
    ViewData["Title"] = "Log New Call";
}

<div class="row justify-content-center">
    <div class="col-lg-10 col-xl-9">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <a asp-action="Index" class="text-decoration-none small text-muted">&larr; Back to Calls list</a>
                <h1 class="h3 fw-bold mb-0 text-dark">Log New Call</h1>
            </div>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                <i class="bi bi-cpu me-1"></i> Real-time Sentiment Analysis
            </span>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-bottom">
                <span class="fw-semibold text-dark">
                    <i class="bi bi-telephone-inbound me-1 text-primary"></i> Caller & Call Transcript Details
                </span>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <partial name="_CallForm" model="Model" />
                    <div class="d-flex align-items-center gap-2 mt-4 pt-3 border-top">
                        <button type="submit" class="btn btn-primary px-4 shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Save and Analyse Call
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-3">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
