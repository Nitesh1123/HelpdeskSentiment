@model CallRecord
@{
    ViewData["Title"] = "Log new call";
}

<h1 class="h3 mb-3">@ViewData["Title"]</h1>

<form asp-action="Create" method="post">
    <partial name="_CallForm" model="Model" />
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save and analyse</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
