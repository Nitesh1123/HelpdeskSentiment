@model CallRecord
@{
    ViewData["Title"] = "Edit call";
}

<h1 class="h3 mb-3">@ViewData["Title"]</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <input type="hidden" asp-for="Id" />
    <partial name="_CallForm" model="Model" />
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save and re-analyse</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
