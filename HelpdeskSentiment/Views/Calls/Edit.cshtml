@model CallRecord
@{
    ViewData["Title"] = "Edit Call #" + Model.Id;
}

<div class="row justify-content-center">
    <div class="col-lg-10 col-xl-9">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <a asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none small text-muted">&larr; Back to Call Details</a>
                <h1 class="h3 fw-bold mb-0 text-dark">Edit Call #@Model.Id</h1>
            </div>
            <span class="badge bg-secondary-subtle text-secondary border">
                <i class="bi bi-pencil-square me-1"></i> Update & Re-analyse
            </span>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-bottom">
                <span class="fw-semibold text-dark">
                    <i class="bi bi-telephone-inbound me-1 text-primary"></i> Update Caller & Transcript
                </span>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    <input type="hidden" asp-for="Id" />
                    <partial name="_CallForm" model="Model" />
                    <div class="d-flex align-items-center gap-2 mt-4 pt-3 border-top">
                        <button type="submit" class="btn btn-primary px-4 shadow-sm">
                            <i class="bi bi-arrow-repeat me-1"></i> Save and Re-analyse
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary px-3">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
