@model List<CallRecord>
@{
    var recent = (List<CallRecord>)ViewBag.RecentCalls;
    SentimentLabel? selected = ViewBag.Sentiment;
    string? search = ViewBag.Search;
    bool hasFilter = selected != null || !string.IsNullOrWhiteSpace(search);
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h1 class="h3 fw-bold mb-1 d-flex align-items-center gap-2">
            <span>Incoming Calls</span>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6 rounded-pill">@Model.Count total</span>
        </h1>
        <p class="text-muted mb-0 small">Real-time caller sentiment analysis, transcript review, and supervisor escalation flags.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary px-3 shadow-sm d-flex align-items-center gap-1">
            <i class="bi bi-plus-lg"></i>
            <span>Log New Call</span>
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-9">
        <!-- Interactive Search & Filter Card -->
        <div class="card mb-4 border-0 shadow-sm">
            <div class="card-body p-3">
                <form method="get" class="row g-2 align-items-center" id="filterForm">
                    <div class="col-md-5">
                        <div class="input-group">
                            <span class="input-group-text bg-white text-muted border-end-0">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" id="liveSearchInput" name="search" value="@search" class="form-control border-start-0" placeholder="Filter by name, phone, or transcript..." />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <select name="sentiment" class="form-select" onchange="this.form.submit()">
                            <option value="">All Sentiments</option>
                            @foreach (SentimentLabel s in Enum.GetValues<SentimentLabel>())
                            {
                                <option value="@s" selected="@(selected == s)">@s</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-fill">
                            <i class="bi bi-funnel me-1"></i> Filter
                        </button>
                        @if (hasFilter)
                        {
                            <a asp-action="Index" class="btn btn-outline-secondary" title="Clear all filters">
                                <i class="bi bi-x-circle"></i>
                            </a>
                        }
                    </div>
                </form>

                <!-- Quick Filter Pills -->
                <div class="d-flex flex-wrap align-items-center gap-2 mt-3 pt-2 border-top">
                    <span class="small text-muted fw-semibold me-1"><i class="bi bi-sliders me-1"></i> Quick View:</span>
                    <a asp-action="Index" class="badge text-decoration-none @(selected == null ? "bg-dark text-white" : "bg-light text-dark border")">All</a>
                    <a asp-action="Index" asp-route-sentiment="Positive" class="badge text-decoration-none @(selected == SentimentLabel.Positive ? "bg-success text-white" : "bg-success-subtle text-success border border-success-subtle")">🙂 Positive</a>
                    <a asp-action="Index" asp-route-sentiment="Neutral" class="badge text-decoration-none @(selected == SentimentLabel.Neutral ? "bg-secondary text-white" : "bg-secondary-subtle text-secondary border border-secondary-subtle")">😐 Neutral</a>
                    <a asp-action="Index" asp-route-sentiment="Negative" class="badge text-decoration-none @(selected == SentimentLabel.Negative ? "bg-danger text-white" : "bg-danger-subtle text-danger border border-danger-subtle")">😠 Negative</a>
                </div>
            </div>
        </div>

        @if (Model.Count == 0)
        {
            <div class="card border-0 shadow-sm text-center py-5">
                <div class="card-body">
                    <div class="display-6 text-muted mb-2">📭</div>
                    <h5 class="text-secondary fw-semibold">No calls match your criteria</h5>
                    <p class="text-muted small">Try adjusting your search terms or clearing the sentiment filter.</p>
                    <a asp-action="Index" class="btn btn-sm btn-outline-primary">View All Calls</a>
                </div>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="callsTable">
                        <thead>
                            <tr>
                                <th class="ps-3">Timestamp</th>
                                <th>Caller</th>
                                <th>Category</th>
                                <th>Agent</th>
                                <th>Sentiment</th>
                                <th class="text-end">Score</th>
                                <th class="text-end pe-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var call in Model)
                            {
                                <tr class="call-row @(call.IsEscalated ? "table-danger bg-opacity-25" : "")">
                                    <td class="text-nowrap ps-3">
                                        <div class="fw-semibold text-dark">@call.CallTime.ToString("dd MMM")</div>
                                        <div class="small text-muted font-monospace">@call.CallTime.ToString("HH:mm")</div>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark caller-name">@call.CallerName</div>
                                        <div class="small text-muted font-monospace caller-phone">@call.PhoneNumber</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@call.Category</span>
                                    </td>
                                    <td>
                                        <span class="small fw-semibold text-secondary">
                                            <i class="bi bi-person-circle me-1"></i>@(call.Agent?.Name ?? "Unassigned")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-1">
                                            <partial name="_SentimentBadge" model="call.Sentiment" />
                                            @if (call.IsEscalated)
                                            {
                                                <span class="badge bg-danger shadow-xs" title="Escalation required">
                                                    <i class="bi bi-exclamation-triangle-fill"></i> Escalated
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td class="text-end font-monospace fw-semibold @(call.SentimentScore < -0.1 ? "text-danger" : (call.SentimentScore > 0.1 ? "text-success" : "text-muted"))">
                                        @call.SentimentScore.ToString("+0.00;-0.00;0.00")
                                    </td>
                                    <td class="text-end pe-3 text-nowrap">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@call.Id" class="btn btn-outline-primary" title="View call details">
                                                <i class="bi bi-eye"></i> View
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@call.Id" class="btn btn-outline-secondary" title="Edit call">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center py-2 px-3">
                    <span class="text-muted small" id="rowCountDisplay">Showing <strong>@Model.Count</strong> call(s)</span>
                    @if (hasFilter)
                    {
                        <span class="badge bg-info-subtle text-info border border-info-subtle small">Filtered view</span>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Recently Viewed Sidebar -->
    <div class="col-lg-3">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <span class="fw-bold d-flex align-items-center gap-1">
                    <i class="bi bi-clock-history text-primary"></i> Recently Viewed
                </span>
                <span class="badge bg-secondary-subtle text-secondary rounded-pill">@recent.Count / 5</span>
            </div>
            <ul class="list-group list-group-flush">
                @if (recent.Count == 0)
                {
                    <li class="list-group-item text-muted small py-4 text-center">
                        <i class="bi bi-info-circle fs-4 d-block mb-1 text-secondary"></i>
                        Calls you inspect in this session will appear here for fast access.
                    </li>
                }
                @foreach (var call in recent)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
                        <div class="pe-2 text-truncate">
                            <a asp-action="Details" asp-route-id="@call.Id" class="text-decoration-none fw-semibold d-block text-truncate">
                                @call.CallerName
                            </a>
                            <span class="text-muted small font-monospace">@call.PhoneNumber</span>
                        </div>
                        <partial name="_SentimentBadge" model="call.Sentiment" />
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Instant client-side search filter as user types
        document.getElementById('liveSearchInput')?.addEventListener('input', function (e) {
            const query = e.target.value.toLowerCase().trim();
            const rows = document.querySelectorAll('#callsTable tbody tr.call-row');
            let visibleCount = 0;

            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                if (text.includes(query)) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            const countDisplay = document.getElementById('rowCountDisplay');
            if (countDisplay) {
                countDisplay.innerHTML = `Showing <strong>${visibleCount}</strong> of ${rows.length} call(s)`;
            }
        });
    </script>
}
