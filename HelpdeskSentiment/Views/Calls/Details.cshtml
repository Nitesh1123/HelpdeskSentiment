@model CallRecord
@{
    ViewData["Title"] = "Call from " + Model.CallerName;
    // Map score -1..+1 to 0..100 for the progress bar.
    int percent = (int)Math.Round((Model.SentimentScore + 1) * 50);
    string barCss = Model.Sentiment switch
    {
        SentimentLabel.Positive => "bg-success",
        SentimentLabel.Negative => "bg-danger",
        _ => "bg-secondary"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@ViewData["Title"]</h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Edit</a>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Delete</a>
        }
    </div>
</div>

@if (Model.IsEscalated)
{
    <div class="alert alert-danger"><strong>Escalation needed.</strong> The caller is very unhappy or asked for a supervisor / legal action. Please arrange a call back.</div>
}

<div class="row g-4">
    <div class="col-md-5">
        <div class="card">
            <div class="card-body">
                <h2 class="h6 text-muted">Sentiment</h2>
                <p class="fs-4 mb-2"><partial name="_SentimentBadge" model="Model.Sentiment" /></p>
                <div class="progress mb-1" role="progressbar" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar @barCss" style="width:@percent%"></div>
                </div>
                <div class="d-flex justify-content-between small text-muted">
                    <span>-1 negative</span><span>score @Model.SentimentScore.ToString("+0.000;-0.000;0")</span><span>+1 positive</span>
                </div>
                <hr />
                <dl class="row mb-0">
                    <dt class="col-5">@Html.DisplayNameFor(m => m.PhoneNumber)</dt><dd class="col-7">@Model.PhoneNumber</dd>
                    <dt class="col-5">@Html.DisplayNameFor(m => m.Category)</dt><dd class="col-7">@Model.Category</dd>
                    <dt class="col-5">@Html.DisplayNameFor(m => m.AgentId)</dt><dd class="col-7">@(Model.Agent?.Name ?? "—")</dd>
                    <dt class="col-5">@Html.DisplayNameFor(m => m.CallTime)</dt><dd class="col-7">@Model.CallTime.ToString("dd MMM yyyy, HH:mm")</dd>
                    <dt class="col-5">@Html.DisplayNameFor(m => m.DurationSeconds)</dt><dd class="col-7">@(Model.DurationSeconds / 60)m @(Model.DurationSeconds % 60)s</dd>
                    <dt class="col-5">@Html.DisplayNameFor(m => m.Keywords)</dt><dd class="col-7">@(string.IsNullOrEmpty(Model.Keywords) ? "none" : Model.Keywords)</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6 text-muted">@Html.DisplayNameFor(m => m.Transcript)</h2>
                <p class="mb-0" style="white-space:pre-wrap">@Model.Transcript</p>
            </div>
        </div>
    </div>
</div>

<a asp-action="Index" class="d-inline-block mt-3">&larr; Back to all calls</a>
