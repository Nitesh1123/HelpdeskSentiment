@model CallRecord
@{
    ViewData["Title"] = "Delete Call #" + Model.Id;
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="mb-3">
            <a asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none small text-muted">&larr; Back to Call Details</a>
            <h1 class="h3 fw-bold mb-0 text-danger mt-1">Confirm Deletion</h1>
        </div>

        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white py-3">
                <span class="fw-semibold"><i class="bi bi-exclamation-triangle-fill me-1"></i> Permanent Deletion Warning</span>
            </div>
            <div class="card-body p-4">
                <p>Are you sure you want to permanently delete the call record for <strong>@Model.CallerName</strong>?</p>
                <div class="bg-light p-3 rounded mb-3 small font-monospace">
                    <div><strong>Date:</strong> @Model.CallTime.ToString("dd MMM yyyy, HH:mm")</div>
                    <div><strong>Phone:</strong> @Model.PhoneNumber</div>
                    <div><strong>Sentiment:</strong> @Model.Sentiment (@Model.SentimentScore)</div>
                </div>
                <p class="text-muted small mb-0">This action cannot be undone and will remove all sentiment scores and transcript records.</p>
                
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-4 pt-3 border-top d-flex gap-2">
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-trash me-1"></i> Delete Call
                    </button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary px-3">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
