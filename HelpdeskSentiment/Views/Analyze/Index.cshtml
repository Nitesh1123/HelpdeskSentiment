@model AnalyzeViewModel
@{
    ViewData["Title"] = "Analyse Text Playground";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-2">
    <div>
        <h1 class="h3 fw-bold mb-1 d-flex align-items-center gap-2">
            <span>Sentiment Analyser Playground</span>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6 rounded-pill">
                <i class="bi bi-cpu me-1"></i> Lexicon Engine
            </span>
        </h1>
        <p class="text-muted mb-0 small">Test raw conversation text against the Lexicon rules without storing records to the database.</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm p-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <label asp-for="Text" class="form-label mb-0 fw-semibold">
                    <i class="bi bi-pencil-square text-primary me-1"></i> Input Text / Transcript
                </label>
            </div>

            <!-- Quick sample buttons -->
            <div class="d-flex flex-wrap align-items-center gap-1 mb-3">
                <span class="small text-muted me-1">Try preset:</span>
                <button type="button" class="quick-chip" onclick="setPreset('angry')">😡 Angry Bill</button>
                <button type="button" class="quick-chip" onclick="setPreset('happy')">😊 Support Praise</button>
                <button type="button" class="quick-chip" onclick="setPreset('negation')">🔄 Negation ('not happy')</button>
                <button type="button" class="quick-chip" onclick="setPreset('escalate')">⚠️ Legal / Manager Threat</button>
            </div>

            <form asp-action="Index" method="post">
                <textarea asp-for="Text" id="analyzerText" class="form-control mb-2 font-monospace" rows="6"
                          placeholder="Type or paste any customer review, sentence, or call transcript here..."></textarea>
                <span asp-validation-for="Text" class="text-danger small d-block mb-3"></span>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4 shadow-sm">
                        <i class="bi bi-play-circle me-1"></i> Calculate Sentiment
                    </button>
                    <button type="button" class="btn btn-outline-secondary" onclick="document.getElementById('analyzerText').value='';">
                        Clear
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-5">
        @if (Model.Result != null)
        {
            var r = Model.Result;
            int percent = (int)Math.Round((r.Score + 1) * 50);
            string barCss = r.Label switch
            {
                SentimentLabel.Positive => "bg-success",
                SentimentLabel.Negative => "bg-danger",
                _ => "bg-secondary"
            };

            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <span class="fw-bold"><i class="bi bi-speedometer2 text-primary me-1"></i> Result Breakdown</span>
                    <span class="badge bg-light text-muted border">@r.TokenCount words read</span>
                </div>
                <div class="card-body">
                    <div class="text-center py-2 mb-3">
                        <div class="fs-4 mb-1">
                            <partial name="_SentimentBadge" model="r.Label" />
                            @if (r.ShouldEscalate)
                            {
                                <span class="badge bg-danger ms-1">⚠️ Flagged For Escalation</span>
                            }
                        </div>
                        <div class="display-6 fw-bold @(r.Score < 0 ? "text-danger" : (r.Score > 0 ? "text-success" : "text-muted"))">
                            @r.Score.ToString("+0.000;-0.000;0.000")
                        </div>
                        <div class="small text-muted">Calculated Sentiment Score</div>
                    </div>

                    <!-- Progress Bar -->
                    <div class="mb-4">
                        <div class="d-flex justify-content-between small text-muted font-monospace mb-1">
                            <span>-1.0 Negative</span>
                            <span>0.0 Neutral</span>
                            <span>+1.0 Positive</span>
                        </div>
                        <div class="progress" style="height: 10px;">
                            <div class="progress-bar @barCss progress-bar-striped progress-bar-animated" style="width: @percent%"></div>
                        </div>
                    </div>

                    <!-- Word Detections -->
                    <div class="mb-3">
                        <div class="small fw-semibold text-success mb-1">
                            <i class="bi bi-plus-circle me-1"></i> Positive Words Found:
                        </div>
                        <div>
                            @if (r.PositiveWords.Count == 0)
                            {
                                <span class="text-muted small">None</span>
                            }
                            else
                            {
                                @foreach (var w in r.PositiveWords)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle me-1 mb-1">@w</span>
                                }
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="small fw-semibold text-danger mb-1">
                            <i class="bi bi-dash-circle me-1"></i> Negative Words Found:
                        </div>
                        <div>
                            @if (r.NegativeWords.Count == 0)
                            {
                                <span class="text-muted small">None</span>
                            }
                            else
                            {
                                @foreach (var w in r.NegativeWords)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle me-1 mb-1">@w</span>
                                }
                            }
                        </div>
                    </div>

                    <div class="alert alert-light border small text-muted mb-0">
                        <i class="bi bi-info-circle me-1"></i> Analysed by <strong>@ViewBag.AnalyzerName</strong>. Negation rules and intensifier modifiers were processed.
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm h-100 text-center py-5 d-flex align-items-center justify-content-center">
                <div class="card-body">
                    <div class="display-6 text-muted mb-3">🔍</div>
                    <h5 class="text-secondary fw-semibold">No Text Analysed Yet</h5>
                    <p class="text-muted small" style="max-width: 320px; margin: 0 auto;">
                        Click one of the quick preset buttons or type your own sentence on the left, then click <strong>Calculate Sentiment</strong>.
                    </p>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const presets = {
            angry: "My bill is completely incorrect again, and nobody is helping me! I am extremely angry and furious with this terrible service.",
            happy: "Thank you so much! Priya was extraordinarily helpful, kind, and solved my problem in less than two minutes. Excellent support!",
            negation: "I am not happy with the current speed and the connection is not working properly.",
            escalate: "I have been overcharged three months in a row. Transfer me to your senior supervisor or manager immediately, or I will file a police complaint!"
        };

        function setPreset(key) {
            const ta = document.getElementById('analyzerText');
            if (ta && presets[key]) {
                ta.value = presets[key];
            }
        }
    </script>
}
